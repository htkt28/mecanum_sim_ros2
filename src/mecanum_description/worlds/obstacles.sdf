<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="mecanum_obstacles">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Mặt sàn phẳng -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Khung tường bao 10m x 10m -->
    <model name="arena_walls">
      <static>true</static>
      <link name="wall_north">
        <pose>5.0 0.0 0.5 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.2 10.2 1.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.2 10.2 1.0</size></box></geometry>
          <material><ambient>0.5 0.55 0.6 1</ambient><diffuse>0.5 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_south">
        <pose>-5.0 0.0 0.5 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.2 10.2 1.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.2 10.2 1.0</size></box></geometry>
          <material><ambient>0.5 0.55 0.6 1</ambient><diffuse>0.5 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_west">
        <pose>0.0 5.0 0.5 0 0 0</pose>
        <collision name="col"><geometry><box><size>10.0 0.2 1.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>10.0 0.2 1.0</size></box></geometry>
          <material><ambient>0.5 0.55 0.6 1</ambient><diffuse>0.5 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_east">
        <pose>0.0 -5.0 0.5 0 0 0</pose>
        <collision name="col"><geometry><box><size>10.0 0.2 1.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>10.0 0.2 1.0</size></box></geometry>
          <material><ambient>0.5 0.55 0.6 1</ambient><diffuse>0.5 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Các vách ngăn và vật cản bất đối xứng giúp SLAM/AMCL định vị chính xác & kiểm thử trượt ngang -->
    <model name="partition_L">
      <static>true</static>
      <link name="seg_1">
        <pose>2.2 1.8 0.4 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.2 2.4 0.8</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.2 2.4 0.8</size></box></geometry>
          <material><ambient>0.8 0.4 0.2 1</ambient><diffuse>0.8 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
      <link name="seg_2">
        <pose>3.1 0.7 0.4 0 0 0</pose>
        <collision name="col"><geometry><box><size>1.8 0.2 0.8</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.8 0.2 0.8</size></box></geometry>
          <material><ambient>0.8 0.4 0.2 1</ambient><diffuse>0.8 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Hành lang hẹp kiểm thử khả năng lách ngang (strafing) của xe Mecanum -->
    <model name="corridor_boxes">
      <static>true</static>
      <link name="box_left">
        <pose>-2.0 2.2 0.4 0 0 0</pose>
        <collision name="col"><geometry><box><size>1.6 0.6 0.8</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.6 0.6 0.8</size></box></geometry>
          <material><ambient>0.2 0.5 0.8 1</ambient><diffuse>0.2 0.5 0.8 1</diffuse></material>
        </visual>
      </link>
      <link name="box_right">
        <pose>-2.0 0.7 0.4 0 0 0</pose>
        <collision name="col"><geometry><box><size>1.6 0.6 0.8</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.6 0.6 0.8</size></box></geometry>
          <material><ambient>0.2 0.5 0.8 1</ambient><diffuse>0.2 0.5 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Các cột trụ tròn -->
    <model name="pillars">
      <static>true</static>
      <link name="pillar_1">
        <pose>1.8 -2.0 0.5 0 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.2 0.7 0.4 1</ambient><diffuse>0.2 0.7 0.4 1</diffuse></material>
        </visual>
      </link>
      <link name="pillar_2">
        <pose>-1.8 -2.5 0.5 0 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.75 0.65 0.2 1</ambient><diffuse>0.75 0.65 0.2 1</diffuse></material>
        </visual>
      </link>
      <link name="crate_se">
        <pose>0.2 -3.2 0.35 0 0 0.4</pose>
        <collision name="col"><geometry><box><size>0.8 0.8 0.7</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.8 0.8 0.7</size></box></geometry>
          <material><ambient>0.6 0.3 0.5 1</ambient><diffuse>0.6 0.3 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
