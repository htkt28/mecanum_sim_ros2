<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- 1. Khớp nối cố định (Tính toán trục Z chính xác từ tâm thân xe) -->
    <joint name="laser_joint" type="fixed">
        <parent link="chassis"/>
        <child link="laser_frame"/>
        <!-- Z = 0.055m (nửa thân xe) + 0.035m (nửa lidar) = 0.09m -->
        <origin xyz="0 0 0.09" rpy="0 0 0"/>
    </joint>

    <!-- 2. Khung vật lý của LiDAR (Dày 7cm) -->
    <link name="laser_frame">
        <visual>
            <geometry>
                <cylinder radius="0.03" length="0.07"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.03" length="0.07"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.1"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.000045"/>
        </inertial>
    </link>

    <!-- 3. Cấu hình Cảm biến ảo cho Gazebo Harmonic -->
    <gazebo reference="laser_frame">
        <material>Gazebo/Black</material>
        <sensor name="laser" type="gpu_lidar">
            <pose>0 0 0 0 0 0</pose>
            <visualize>true</visualize>
            <update_rate>10</update_rate>

            <topic>/scan</topic>
            <!-- Bắt buộc giữ dòng này để đồng bộ tên frame với RViz -->
            <gz_frame_id>laser_frame</gz_frame_id>
            
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.15</min>
                    <max>12.0</max>
                    <resolution>0.01</resolution>
                </range>
            </ray>
        </sensor>
    </gazebo>

    <!-- 4. Khởi động hệ thống tính toán Cảm biến của Gazebo -->
    <gazebo>
        <plugin filename="libgz-sim-sensors-system.so" name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>
    </gazebo>

</robot>