<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Thông số module GY-521 MPU6050 (21 x 16 x 3 mm, nặng ~5g) -->
    <xacro:property name="imu_length" value="0.021"/>
    <xacro:property name="imu_width" value="0.016"/>
    <xacro:property name="imu_height" value="0.003"/>
    <xacro:property name="imu_mass" value="0.005"/>

    <!-- 1. Đặt MPU6050 đúng tâm trục xoay (x=0, y=0) để triệt tiêu gia tốc hướng tâm khi xe quay -->
    <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="0 0 ${wheel_radius + 0.01}" rpy="0 0 0"/>
    </joint>

    <!-- 2. Khung vật lý của module MPU6050 -->
    <link name="imu_link">
        <visual>
            <geometry>
                <box size="${imu_length} ${imu_width} ${imu_height}"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <xacro:inertial_box mass="${imu_mass}" x="${imu_length}" y="${imu_width}" z="${imu_height}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <!-- 3. Cảm biến IMU 6 trục mô phỏng đặc tính nhiễu thực tế của InvenSense MPU-6050 (100 Hz) -->
    <gazebo reference="imu_link">
        <sensor name="mpu6050" type="imu">
            <pose>0 0 0 0 0 0</pose>
            <always_on>true</always_on>
            <update_rate>100</update_rate>
            <visualize>true</visualize>
            <topic>/imu/data</topic>
            <gz_frame_id>imu_link</gz_frame_id>
            <imu>
                <angular_velocity>
                    <x>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.00087</stddev>
                            <bias_mean>0.00005</bias_mean>
                            <bias_stddev>0.00001</bias_stddev>
                        </noise>
                    </x>
                    <y>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.00087</stddev>
                            <bias_mean>0.00005</bias_mean>
                            <bias_stddev>0.00001</bias_stddev>
                        </noise>
                    </y>
                    <z>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.00087</stddev>
                            <bias_mean>0.00005</bias_mean>
                            <bias_stddev>0.00001</bias_stddev>
                        </noise>
                    </z>
                </angular_velocity>
                <linear_acceleration>
                    <x>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.039</stddev>
                            <bias_mean>0.005</bias_mean>
                            <bias_stddev>0.001</bias_stddev>
                        </noise>
                    </x>
                    <y>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.039</stddev>
                            <bias_mean>0.005</bias_mean>
                            <bias_stddev>0.001</bias_stddev>
                        </noise>
                    </y>
                    <z>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.039</stddev>
                            <bias_mean>0.005</bias_mean>
                            <bias_stddev>0.001</bias_stddev>
                        </noise>
                    </z>
                </linear_acceleration>
            </imu>
        </sensor>
    </gazebo>

    <!-- 4. Khởi động hệ thống tính toán IMU của Gazebo Harmonic -->
    <gazebo>
        <plugin filename="libgz-sim-imu-system.so" name="gz::sim::systems::Imu"/>
    </gazebo>

</robot>
