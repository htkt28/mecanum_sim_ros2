<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema" name="mecanum_robot">

    <!-- 1. KHAI BÁO KÍCH THƯỚC KHUNG XE 2 TẦNG -->
    <!-- Tầng 1: Dài 30cm (0.30m), Rộng 24cm (0.24m), Dày 2cm (0.02m) -->
    <xacro:property name="chassis_length" value="0.30"/>
    <xacro:property name="chassis_width" value="0.24"/>
    <xacro:property name="layer1_height" value="0.02"/>

    <!-- Tầng 2: Dài 20cm (0.20m), Rộng 24cm (0.24m), Cao thêm 8cm (0.08m) tính từ Tầng 1,
         lùi sát về phía đuôi xe (mép sau Tầng 2 trùng với mép đuôi Tầng 1 tại x = -0.15m) -->
    <xacro:property name="layer2_length" value="0.20"/>
    <xacro:property name="layer2_width" value="0.24"/>
    <xacro:property name="layer2_offset_x" value="${-(chassis_length - layer2_length)/2}"/>
    <xacro:property name="layer2_elevation" value="0.08"/>
    <xacro:property name="layer2_thickness" value="0.01"/>
    <xacro:property name="standoff_height" value="${layer2_elevation - layer2_thickness}"/>
    <xacro:property name="standoff_radius" value="0.006"/>
    <xacro:property name="chassis_total_height" value="${layer1_height + layer2_elevation}"/>
    <xacro:property name="chassis_mass" value="4.4"/>

    <!-- 2. KÍCH THƯỚC BÁNH XE MECANUM -->
    <xacro:property name="wheel_radius" value="0.0485"/>
    <xacro:property name="wheel_thickness" value="0.048"/>
    <xacro:property name="wheel_mass" value="0.15"/>

    <!-- 3. TỌA ĐỘ ĐẶT BÁNH (Lx + Ly = 0.125 + 0.15 = 0.275m) -->
    <xacro:property name="wheel_offset_x" value="0.125"/>
    <xacro:property name="wheel_offset_y" value="0.15"/>
    <!-- Khoảng cách theo phương thẳng đứng từ tâm trục bánh xe lên mép dưới của Tầng 1: 3cm (0.03m) -->
    <xacro:property name="wheel_to_layer1_bottom_z" value="0.03"/>

    <!-- ================= CÔNG THỨC TÍNH QUÁN TÍNH TỰ ĐỘNG ================= -->
    <xacro:macro name="inertial_box" params="mass x y z *origin">
        <inertial>
            <xacro:insert_block name="origin"/>
            <mass value="${mass}" />
            <inertia ixx="${(1/12) * mass * (y*y+z*z)}" ixy="0.0" ixz="0.0"
                     iyy="${(1/12) * mass * (x*x+z*z)}" iyz="0.0"
                     izz="${(1/12) * mass * (x*x+y*y)}" />
        </inertial>
    </xacro:macro>

    <xacro:macro name="inertial_cylinder" params="mass length radius *origin">
        <inertial>
            <xacro:insert_block name="origin"/>
            <mass value="${mass}" />
            <inertia ixx="${(1/12) * mass * (3*radius*radius + length*length)}" ixy="0.0" ixz="0.0"
                     iyy="${(1/12) * mass * (3*radius*radius + length*length)}" iyz="0.0"
                     izz="${(1/2) * mass * (radius*radius)}" />
        </inertial>
    </xacro:macro>

    <!-- ================= VẬT LIỆU MÀU SẮC ================= -->
    <material name="white">
        <color rgba="0.95 0.95 0.95 1"/>
    </material>
    <material name="grey">
        <color rgba="0.55 0.58 0.62 1"/>
    </material>
    <material name="orange">
        <color rgba="1 0.3 0.1 1"/>
    </material>
    <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
    </material>
    <material name="blue">
        <color rgba="0.1 0.35 0.85 1"/>
    </material>

    <!-- ================= TÂM XE & BASE FOOTPRINT ================= -->
    <!-- Giữ base_link làm root link để bảo toàn hệ quy chiếu gz:expressed_in="base_link" trong Gazebo -->
    <link name="base_link"/>

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_link"/>
        <child link="base_footprint"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="base_footprint"/>

    <!-- ================= THÂN XE KẾT CẤU 2 TẦNG ================= -->
    <!-- Mép dưới Tầng 1 cao hơn tâm bánh xe 3cm (0.03m) -> Tâm Tầng 1 ở z = wheel_radius + 0.03 + layer1_height/2 = 0.0885m -->
    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz="0 0 ${wheel_radius + wheel_to_layer1_bottom_z + layer1_height/2}" rpy="0 0 0"/>
    </joint>

    <xacro:macro name="standoff_visual" params="x_sign y_sign">
        <visual>
            <origin xyz="${layer2_offset_x + x_sign * (layer2_length/2 - 0.015)} ${y_sign * (layer2_width/2 - 0.015)} ${layer1_height/2 + standoff_height/2}" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${standoff_radius}" length="${standoff_height}"/>
            </geometry>
            <material name="grey"/>
        </visual>
    </xacro:macro>

    <link name="chassis">
        <!-- Tầng 1: Đế dưới 30x24cm, dày 2cm (0.02m) -->
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${layer1_height}"/>
            </geometry>
            <material name="white"/>
        </visual>

        <!-- 4 Trụ chống tại 4 góc Tầng 2 (2 cột sau sát đuôi xe tại x = -0.135m, 2 cột trước tại x = +0.035m) -->
        <xacro:standoff_visual x_sign="1"  y_sign="1"/>
        <xacro:standoff_visual x_sign="1"  y_sign="-1"/>
        <xacro:standoff_visual x_sign="-1" y_sign="1"/>
        <xacro:standoff_visual x_sign="-1" y_sign="-1"/>

        <!-- Tầng 2: 20x24cm, lùi sát đuôi xe (tâm ở x = -0.05m), cao thêm 8cm từ Tầng 1 -->
        <visual>
            <origin xyz="${layer2_offset_x} 0 ${layer1_height/2 + layer2_elevation - layer2_thickness/2}" rpy="0 0 0"/>
            <geometry>
                <box size="${layer2_length} ${layer2_width} ${layer2_thickness}"/>
            </geometry>
            <material name="white"/>
        </visual>

        <!-- Khung va chạm bao toàn bộ khối 2 tầng (cao 10cm) -->
        <collision>
            <origin xyz="0 0 ${layer2_elevation/2}" rpy="0 0 0"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_total_height}"/>
            </geometry>
        </collision>

        <!-- Trọng tâm đặt thấp ở cụm 4 động cơ dưới gầm Tầng 1 để chống lật khi tăng tốc/trượt ngang -->
        <xacro:inertial_box mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_total_height}">
            <origin xyz="0 0 -0.03" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <!-- ================= KHUÔN ĐÚC BÁNH XE MECANUM & VẬT LÝ GAZEBO ================= -->
    <xacro:macro name="mecanum_wheel" params="prefix x_reflect y_reflect fdir1">
        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_wheel"/>
            <origin xyz="${x_reflect * wheel_offset_x} ${y_reflect * wheel_offset_y} ${wheel_radius}" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
        </joint>

        <link name="${prefix}_wheel">
            <visual>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
                </geometry>
                <material name="orange"/>
            </visual>
            <!-- Va chạm hình cầu tiếp xúc 1 điểm giúp bánh xe trượt ngang mượt mà -->
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <sphere radius="${wheel_radius}"/>
                </geometry>
            </collision>
            <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_thickness}" radius="${wheel_radius}">
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            </xacro:inertial_cylinder>
        </link>

        <!-- Cấu hình ma sát dị hướng (fdir1) chuẩn cho con lăn 45 độ trên Gazebo Harmonic -->
        <gazebo reference="${prefix}_wheel">
            <collision>
                <surface>
                    <friction>
                        <ode>
                            <mu>2.0</mu>
                            <mu2>0.0</mu2>
                            <fdir1 gz:expressed_in="base_link">${fdir1}</fdir1>
                        </ode>
                    </friction>
                    <contact>
                        <ode>
                            <kp>100000.0</kp>
                            <kd>10.0</kd>
                            <max_vel>0.1</max_vel>
                            <min_depth>0.001</min_depth>
                        </ode>
                    </contact>
                </surface>
            </collision>
        </gazebo>
    </xacro:macro>

    <!-- ================= GẮN 4 BÁNH XE VÀO 4 GÓC ================= -->
    <!-- Cặp Trước Trái & Sau Phải: Vector ma sát 1 -1 0 -->
    <xacro:mecanum_wheel prefix="front_left"  x_reflect="1"  y_reflect="1"  fdir1="1 -1 0" />
    <xacro:mecanum_wheel prefix="rear_right"  x_reflect="-1" y_reflect="-1" fdir1="1 -1 0" />

    <!-- Cặp Trước Phải & Sau Trái: Vector ma sát 1 1 0 -->
    <xacro:mecanum_wheel prefix="front_right" x_reflect="1"  y_reflect="-1" fdir1="1 1 0" />
    <xacro:mecanum_wheel prefix="rear_left"   x_reflect="-1" y_reflect="1"  fdir1="1 1 0" />

    <!-- ================= NHÚNG CÁC FILE MỞ RỘNG ================= -->
    <xacro:include filename="$(find mecanum_description)/urdf/ros2_control.xacro" />
    <xacro:include filename="$(find mecanum_description)/urdf/lidar.xacro" />
    <xacro:include filename="$(find mecanum_description)/urdf/imu.xacro" />
</robot>
