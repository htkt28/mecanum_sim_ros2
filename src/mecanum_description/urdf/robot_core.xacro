<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema" name="mecanum_robot">

    <!-- 1. KHAI BÁO KÍCH THƯỚC (Dễ dàng thay đổi sau này) -->
    <xacro:property name="chassis_length" value="0.3"/>
    <xacro:property name="chassis_width" value="0.24"/>
    <xacro:property name="chassis_height" value="0.11"/>
    
    <!-- 2. Kích thước Bánh xe Mecanum -->
    <xacro:property name="wheel_radius" value="0.0485"/>
    <xacro:property name="wheel_thickness" value="0.048"/>

    <!-- 3. Tọa độ đặt bánh -->
    <xacro:property name="wheel_offset_x" value="0.125"/> 
    <xacro:property name="wheel_offset_y" value="0.15"/>

    <!-- ================= CÔNG THỨC TÍNH QUÁN TÍNH TỰ ĐỘNG ================= -->
    <xacro:macro name="inertial_box" params="mass x y z *origin">
        <inertial>
            <xacro:insert_block name="origin"/>
            <mass value="${mass}" />
            <inertia ixx="${(1/12) * mass * (y*y+z*z)}" ixy="0.0" ixz="0.0"
                     iyy="${(1/12) * mass * (x*x+z*z)}" iyz="0.0"
                     izz="${(1/12) * mass * (x*x+y*y)}" />
        </inertial>
    </xacro:macro>

    <xacro:macro name="inertial_cylinder" params="mass length radius *origin">
        <inertial>
            <xacro:insert_block name="origin"/>
            <mass value="${mass}" />
            <inertia ixx="${(1/12) * mass * (3*radius*radius + length*length)}" ixy="0.0" ixz="0.0"
                     iyy="${(1/12) * mass * (3*radius*radius + length*length)}" iyz="0.0"
                     izz="${(1/2) * mass * (radius*radius)}" />
        </inertial>
    </xacro:macro>
    
    <!-- ================= VẬT LIỆU MÀU SẮC ================= -->
    <material name="white">
        <color rgba="1 1 1 1"/>
    </material>
    <material name="orange">
        <color rgba="1 0.3 0.1 1"/>
    </material>

    <!-- ================= THÂN XE HÌNH HỘP ================= -->
    <link name="base_link"></link>

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz="0 0 ${wheel_radius + chassis_height/2}"/> 
    </joint>

    <link name="chassis">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
        </collision>
        <!-- HẠ TRỌNG TÂM XUỐNG 5cm (z=-0.05) ĐỂ GHÌ XE XUỐNG MẶT ĐẤT -->
        <xacro:inertial_box mass="4.4" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
            <origin xyz="0 0 -0.05" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <!-- ================= KHUÔN ĐÚC BÁNH XE ================= -->
    <xacro:macro name="mecanum_wheel" params="prefix x_reflect y_reflect">
        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_wheel"/>
            <origin xyz="${x_reflect * wheel_offset_x} ${y_reflect * wheel_offset_y} ${wheel_radius}" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
        </joint>

        <link name="${prefix}_wheel">
            <visual>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
                </geometry>
                <material name="orange"/>
            </visual>
            <!-- Va chạm dùng hình cầu để trượt ngang mượt mà -->
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <sphere radius="${wheel_radius}"/>
                </geometry>
            </collision>
            <xacro:inertial_cylinder mass="0.15" length="${wheel_thickness}" radius="${wheel_radius}">
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            </xacro:inertial_cylinder>
        </link>
    </xacro:macro>

    <!-- ================= GẮN 4 BÁNH XE VÀO 4 GÓC ================= -->
    <xacro:mecanum_wheel prefix="front_left" x_reflect="1" y_reflect="1" />
    <xacro:mecanum_wheel prefix="front_right" x_reflect="1" y_reflect="-1" />
    <xacro:mecanum_wheel prefix="rear_left" x_reflect="-1" y_reflect="1" />
    <xacro:mecanum_wheel prefix="rear_right" x_reflect="-1" y_reflect="-1" />

    <!-- ================= CẤU HÌNH VẬT LÝ GAZEBO ĐÃ SỬA LỖI ================= -->
    
    <!-- Cặp Trước Trái & Sau Phải: Vector ma sát 1 1 0 -->
    <gazebo reference="front_left_wheel">
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>1.0</mu>
                        <mu2>0.0</mu2>
                        <fdir1 gz:expressed_in="base_link">1 1 0</fdir1>
                    </ode>
                </friction>
                <contact>
                    <ode>
                        <kp>100000.0</kp>
                        <kd>10.0</kd>
                        <max_vel>0.1</max_vel>
                        <min_depth>0.001</min_depth>
                    </ode>
                </contact>
            </surface>
        </collision>
    </gazebo>

    <gazebo reference="rear_right_wheel">
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>1.0</mu>
                        <mu2>0.0</mu2>
                        <fdir1 gz:expressed_in="base_link">1 1 0</fdir1>
                    </ode>
                </friction>
                <contact>
                    <ode>
                        <kp>100000.0</kp>
                        <kd>10.0</kd>
                        <max_vel>0.1</max_vel>
                        <min_depth>0.001</min_depth>
                    </ode>
                </contact>
            </surface>
        </collision>
    </gazebo>

    <!-- Cặp Trước Phải & Sau Trái: Vector ma sát 1 -1 0 -->
    <gazebo reference="front_right_wheel">
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>1.0</mu>
                        <mu2>0.0</mu2>
                        <fdir1 gz:expressed_in="base_link">1 -1 0</fdir1>
                    </ode>
                </friction>
                <contact>
                    <ode>
                        <kp>100000.0</kp>
                        <kd>10.0</kd>
                        <max_vel>0.1</max_vel>
                        <min_depth>0.001</min_depth>
                    </ode>
                </contact>
            </surface>
        </collision>
    </gazebo>

    <gazebo reference="rear_left_wheel">
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>1.0</mu>
                        <mu2>0.0</mu2>
                        <fdir1 gz:expressed_in="base_link">1 -1 0</fdir1>
                    </ode>
                </friction>
                <contact>
                    <ode>
                        <kp>100000.0</kp>
                        <kd>10.0</kd>
                        <max_vel>0.1</max_vel>
                        <min_depth>0.001</min_depth>
                    </ode>
                </contact>
            </surface>
        </collision>
    </gazebo>

    <!-- ================= NHÚNG CÁC FILE MỞ RỘNG ================= -->
    <xacro:include filename="ros2_control.xacro" />
    <xacro:include filename="lidar.xacro" />
</robot>